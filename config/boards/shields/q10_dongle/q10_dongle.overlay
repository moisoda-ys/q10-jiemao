#include "../../arm/zitaotech_q10/zitaotech_q10-layouts.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layouts = &zitaotech_q10_layout;
        zephyr,display = &oled;
    };

    /* The Q10 peripheral supplies its matrix events to this split central. */
    kscan0: kscan {
        compatible = "zmk,kscan-mock";
        columns = <6>;
        rows = <9>;
        events = <0>;
    };

    default_transform: matrix_transform0: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <9>;
        map = <
            RC(8,1)                                                                   RC(8,5)
            RC(7,1)          RC(8,3)             RC(7,2)             RC(8,4)          RC(7,5)
            RC(0,0)  RC(1,0) RC(0,1) RC(0,2) RC(2,2) RC(2,3) RC(0,3) RC(2,4) RC(0,4)  RC(3,1)
            RC(3,0)  RC(1,1) RC(2,1) RC(6,2) RC(1,2) RC(1,3) RC(6,3) RC(6,4) RC(1,4)  RC(3,4)
            RC(4,0)  RC(5,1) RC(4,1) RC(5,2) RC(4,2) RC(4,3) RC(5,3) RC(5,4) RC(4,4)  RC(3,3)
            RC(6,1)          RC(6,0)             RC(5,0)             RC(2,0)          RC(3,2)
        >;
    };
};

&xiao_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
    };
};
